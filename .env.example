# Server Environment
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL Connection String)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Authentication
JWT_ACCESS_SECRET="super-secret-access-token-key-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-min-32-chars-long"
JWT_REFRESH_EXPIRES_IN="30d"

# Frontend URL (untuk link aktivasi email)
FRONTEND_URL="http://localhost:3000"

# Nodemailer / SMTP Config (Gmail SMTP / Ethereal)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Manajemen Laporan <no-reply@tim-anda.com>"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
